{
  "name": "mcp-gateway",
  "version": "1.0.0",
  "description": "Satu endpoint MCP yang menggabungkan banyak MCP server (stdio, HTTP, SSE).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-gateway": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
