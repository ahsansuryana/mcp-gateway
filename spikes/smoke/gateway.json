{
  "$schema": "../../gateway.schema.json",
  // Smoke configuration for scripts/smoke.sh (PLAN.md S7.6 / F-1).
  //
  // Baked into the image by the Dockerfile, so the smoke test needs no volume and no host
  // bind-mount. The remote Docker host cannot mount a Windows drive at all (B-29), and a
  // config baked into the image is also a config that is proven to work.
  //
  // The upstream command is a path RELATIVE to the gateway's working directory, which is
  // /app in the image and the repository root when run on a developer machine. That is what
  // lets one config drive both, instead of shipping a second copy that drifts.
  //
  // The upstream is a LOCAL stdio child running the in-repo fixture. No network, no
  // third-party server (PLAN.md D15). It exists so the smoke test makes a REAL tools/call:
  // request -> gateway -> child process -> back.
  "gateway": {
    "host": "0.0.0.0",
    "port": 3000,
    // PLAN.md D7: the key is SUBSTITUTED from the environment, exactly as
    // gateway.example.json does. It was a hardcoded literal, which made the smoke config
    // only work for whoever knew that constant: CI passed GATEWAY_API_KEY=ci-smoke-key,
    // the config expected a different literal, and every authenticated check answered
    // 401. A smoke test whose credential is baked into it is not testing the real path.
    "auth": { "type": "bearer", "keys": ["{env:GATEWAY_API_KEY}"] },
    "defaultTimeoutMs": 5000,
    "defaultTtlMs": 30000
  },
  "mcp": {
    "smoke": {
      "type": "local",
      "command": ["node", "spikes/smoke/fake-upstream.mjs"],
      "environment": {},
      "enabled": true,
      "timeout": 5000,
      "startupTimeoutMs": 10000,
      "idleTimeoutMs": 60000
    }
  }
}
