node_modules/
dist/
coverage/

# PLAN.md rule 10: never commit a config that can hold real secrets.
#
# ANCHORED WITH A LEADING SLASH ON PURPOSE. A bare `gateway.json` matches at EVERY depth,
# so it also swallowed `spikes/smoke/gateway.json` -- the smoke configuration the Dockerfile
# COPYs in. That file was therefore never committed, and `docker build` still worked locally
# because the untracked file was sitting in the working directory. CI checked out a clean
# tree and failed with:
#
#   failed to calculate checksum ... "/spikes/smoke/gateway.json": not found
#
# Only the repository root holds an operator config.
/gateway.json

# ADR 0012: per-installation state. Holds gateway.json, and data/ with the encrypted OAuth
# token store. Anchored for the same reason: a bare `.mcp-gateway/` would also ignore a
# directory of that name anywhere else in the tree.
.mcp-gateway/

# Runtime state (OAuth token store, Sprint 5+). Anchored for the same reason: a bare
# `data/` would also match any documentation or fixture directory of that name.
/data/

*.log
.DS_Store
.env
.env.*

# `npm pack` output. A tarball is a build artifact of the exact tree that was packed;
# committing one pins a binary copy of the source that can then drift from it.
*.tgz